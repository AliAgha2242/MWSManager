@using MWSMan.Core.Model.Events
@using Model.PresentationModels
@implements IDisposable
@inject IList<ServerSelected> Servers
@inject CenterEvent CenterEvent

<div class="sidebar server-sidebar @(isCollapsed ? "close" : "")" id="sidebar_Server">
    <div class="logo-details">
        <button type="button" class="sidebar-toggle" id="bx-menu_Server" aria-label="تغییر اندازه فهرست سرورها" title="تغییر اندازه فهرست سرورها" @onclick="ToggleSidebar">
            <i class="bx bx-menu"></i>
        </button>
        <span class="logo_name">سرورها</span>
    </div>
    <div class="checkbox-list">
        <label class="server-select-all">
            <input type="checkbox" checked="@Servers.All(s => s.isSelected)" @onchange="SelectAll" />
            <span>انتخاب همه</span>
        </label>
        @foreach (var item in Servers)
        {
            var state = item.responseInfo.responseState;
            var statusClass = state is ResponseState.FinishWithError ? "server-error" :
                state is ResponseState.Finish ? "server-success" : "server-normal";
            <label class="server-item @statusClass" title="@item.serverInfo.ServerName">
                <InputCheckbox disabled="@(state is ResponseState.Wait)" @bind-Value="item.isSelected" />
                <span class="server-name">@item.serverInfo.ServerName.ToUpperInvariant()</span>
                @if (state is ResponseState.Wait)
                {
                    <span class="server-wait" aria-label="در انتظار">…</span>
                }
                else if (state is ResponseState.FinishWithError)
                {
                    <i class="bx bx-error-circle server-state-icon" aria-label="خطا"></i>
                }
                else if (state is ResponseState.Finish)
                {
                    <i class="bx bx-check-circle server-state-icon" aria-label="موفق"></i>
                }
            </label>
        }
    </div>
</div>

@code {
    private bool isCollapsed;
    private bool disposed;

    protected override void OnInitialized()
    {
        CenterEvent.MyCustomEvent += ChangeServerSelected;
    }

    private void ToggleSidebar() => isCollapsed = !isCollapsed;

    private void SelectAll(ChangeEventArgs e)
    {
        var selected = Convert.ToBoolean(e.Value);
        foreach (var item in Servers)
        {
            if (item.responseInfo.responseState is not ResponseState.Wait)
                item.isSelected = selected;
        }
        StateHasChanged();
    }

    private void ChangeServerSelected()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        CenterEvent.MyCustomEvent -= ChangeServerSelected;
    }
}