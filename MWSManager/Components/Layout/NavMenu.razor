@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<div dir="rtl" class="sidebar @(isCollapsed ? "close" : "")">
    <div class="logo-details">
        <button type="button" class="sidebar-toggle" aria-label="تغییر اندازه منو" title="تغییر اندازه منو" @onclick="ToggleSidebar">
            <i class="bx bx-menu"></i>
        </button>
        <span class="logo_name">MWSManager</span>
    </div>

    <ul class="nav-links">
        <li class="@(requestsOpen ? "showMenu" : "")">
            <div class="iocn-link">
                <button type="button" class="nav-group-button" @onclick="() => ToggleGroup(0)" aria-expanded="@requestsOpen">
                    <i class="bx bx-rss"></i><span class="link_name">درخواست</span>
                </button>
                <button type="button" class="arrow" aria-label="باز و بسته کردن درخواست‌ها" @onclick="() => ToggleGroup(0)"><i class="bx bxs-chevron-down"></i></button>
            </div>
            <ul class="sub-menu">
                <li><NavLink href="/ReqOrMessCreateAndSend/10">درخواست جدید</NavLink></li>
                <li><NavLink href="/ReqOrMessReadySend/10">ارسال درخواست آماده</NavLink></li>
                <li><NavLink href="/ReqOrMessEditDelete/10">حذف و ویرایش درخواست</NavLink></li>
            </ul>
        </li>
        <li class="@(messagesOpen ? "showMenu" : "")">
            <div class="iocn-link">
                <button type="button" class="nav-group-button" @onclick="() => ToggleGroup(1)" aria-expanded="@messagesOpen">
                    <i class="bx bx-message"></i><span class="link_name">پیام</span>
                </button>
                <button type="button" class="arrow" aria-label="باز و بسته کردن پیام‌ها" @onclick="() => ToggleGroup(1)"><i class="bx bxs-chevron-down"></i></button>
            </div>
            <ul class="sub-menu">
                <li><NavLink href="/ReqOrMessCreateAndSend/20">پیام جدید</NavLink></li>
                <li><NavLink href="/ReqOrMessReadySend/20">ارسال پیام آماده</NavLink></li>
                <li><NavLink href="/ReqOrMessEditDelete/20">حذف و ویرایش پیام</NavLink></li>
            </ul>
        </li>
        <li class="@(tasksOpen ? "showMenu" : "")">
            <div class="iocn-link">
                <button type="button" class="nav-group-button" @onclick="() => ToggleGroup(2)" aria-expanded="@tasksOpen">
                    <i class="bx bx-time"></i><span class="link_name">زمان‌بندی</span>
                </button>
                <button type="button" class="arrow" aria-label="باز و بسته کردن زمان‌بندی" @onclick="() => ToggleGroup(2)"><i class="bx bxs-chevron-down"></i></button>
            </div>
            <ul class="sub-menu">
                <li><NavLink href="/RabbitTaskCreate">ایجاد زمان‌بندی</NavLink></li>
                <li><NavLink href="/RabbitTaskRead">لیست زمان‌بندی‌ها</NavLink></li>
            </ul>
        </li>
        <li class="@(readyOpen ? "showMenu" : "")">
            <div class="iocn-link">
                <button type="button" class="nav-group-button" @onclick="() => ToggleGroup(3)" aria-expanded="@readyOpen">
                    <i class="bx bx-book-alt"></i><span class="link_name">عملیات آماده</span>
                </button>
                <button type="button" class="arrow" aria-label="باز و بسته کردن عملیات آماده" @onclick="() => ToggleGroup(3)"><i class="bx bxs-chevron-down"></i></button>
            </div>
            <ul class="sub-menu">
                <li><NavLink href="/ReqOrMessReadyCreate/20">ایجاد پیام آماده</NavLink></li>
                <li><NavLink href="/ReqOrMessReadyCreate/10">ایجاد درخواست آماده</NavLink></li>
                <li><NavLink href="/SendAgainOnLogBase">ارسال مجدد از گزارش</NavLink></li>
            </ul>
        </li>

        <li class="@(monitorOpen ? "showMenu" : "")">
            <div class="iocn-link">
                <button type="button" class="nav-group-button" @onclick="() => ToggleGroup(4)" aria-expanded="@monitorOpen">
                    <i class="bx bx-pulse"></i><span class="link_name">مانیتورینگ</span>
                </button>
                <button type="button" class="arrow" aria-label="باز و بسته کردن مانیتورینگ" @onclick="() => ToggleGroup(4)"><i class="bx bxs-chevron-down"></i></button>
            </div>
            <ul class="sub-menu">
                <li><NavLink href="/RabbitMonitoring">مانیتورینگ RabbitMQ</NavLink></li>
            </ul>
        </li>




      @*   <li class="nav-home nav-monitoring"><NavLink href="/RabbitMonitoring"><i class="bx bx-pulse"></i>
            <span class="link_name">مانیتورینگ RabbitMQ</span></NavLink>
            </li> *@
        <li class="nav-home"><NavLink href="/" Match="NavLinkMatch.All"><i class="bx bx-home-alt-2"></i><div></div><span class="link_name">صفحه اصلی</span></NavLink></li>
        <li class="profile-details">
            <div class="profile-content"><img src="media/logo2 (002).png" alt="نشان شرکت" /></div>
            <div class="name-job"><div class="profile_name">هلدینگ صنعتی مینو</div><div class="job">شرکت قاسم ایران</div></div>
        </li>
    </ul>
</div>

@code {
    private bool isCollapsed = true;
    private bool requestsOpen;
    private bool messagesOpen;
    private bool tasksOpen;
    private bool readyOpen;
    private bool monitorOpen;

    

    private void ToggleSidebar() => isCollapsed = !isCollapsed;

    private void ToggleGroup(int group)
    {
        switch (group)
        {
            case 0: requestsOpen = !requestsOpen; break;
            case 1: messagesOpen = !messagesOpen; break;
            case 2: tasksOpen = !tasksOpen; break;
            case 3: readyOpen = !readyOpen; break;
            case 4: monitorOpen = !monitorOpen; break;

        }
        if (isCollapsed) isCollapsed = false;
    }
}