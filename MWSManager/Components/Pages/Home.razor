@page "/"

<PageTitle>Home</PageTitle>
<style>
    /* فقط استایل‌های مورد نیاز برای کانتینر و متن‌ها - هیچ استایلی روی body نیست */

    .satellite-card {
        display: inline-block;
        background: linear-gradient(75deg, #1e293b, #0f172a00);
        padding: 60px 85px;
        border-radius: 60px 60px 60px 60px;
        box-shadow: 25px 25px 50px rgba(0,0,0,0.3), 0px 0px 0px 2px rgba(255,215,0,0.3), inset 0px 1px 0px rgba(255,255,255,0.1);
        border: 1px solid rgba(255,215,0,0.5);
        text-align: center;
        margin: 50px;
    }

    h1 {
        font-size: 48px;
        font-family: 'Segoe UI', 'Arial Black', sans-serif;
        background: radial-gradient(circle at 30% 10%, #FFD966, #FF8C42);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        text-shadow: 3px 3px 0px rgba(0,0,0,0.2);
        letter-spacing: 1.5px;
        margin: 0 0 20px 0;
    }

    .creator {
        font-size: 22px;
        font-family: 'Courier New', monospace;
        color: #A5F3FF;
        background: rgba(0,0,0,0.5);
        display: inline-block;
        padding: 12px 28px;
        border-radius: 40px;
        letter-spacing: 1px;
        border-left: 4px solid #FFD966;
        border-right: 4px solid #FFD966;
    }

        .creator span {
            color: #FFB347;
            font-weight: bold;
            font-size: 24px;
        }
</style>
<center>
    <div class="satellite-card">
        <h1>🚀 Welcom To MWSManager 🛸</h1>
        <div class="creator">
            👨‍🚀 Creator : <span>Tavakoli</span>
        </div>
    </div>
</center>

