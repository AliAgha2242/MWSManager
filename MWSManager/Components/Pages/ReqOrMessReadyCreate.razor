@page "/ReqOrMessReadyCreate/{ReqOrMess:int}/{reqOrMessId:int?}"
@using Application.ServiceContract
@using FluentValidation
@using FluentValidation.Results
@using MWSMan.Core.Infrastructure.Extenssion
@using MWSMan.Core.Persistence.StaticConfiguration
@using Model.PresentationModels
@using Model.ApplicationModels
@using Persistence
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject IJSRuntime js
@inject IMinooOperationConfiguration operationConfiguration
@inject IList<ServerSelected> ServerSelecteds
@inject IRequestHubService requestHubService
@inject IValidator<RabbitConsumerRequestHub> Validator;
@inject NavigationManager Navigation


<title>@(reqOrMessId is not null ? "ویرایش" : "ایجاد") @(ReqOrMess is RequestOrMessageEnum.Message? "پیام":"درخواست")@(reqOrMessId is null ? " آماده" : "")</title>
<style>
    /* body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f8f9fa;
        font-family: Tahoma, sans-serif;
    } */

    .form-container {
        background: #ffffff7a;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        max-width: 600px;
        width: 85%;
        min-width:500px;
        direction: rtl;
        overflow: hidden;
        transform: scale(1.2);
        transform-origin: center;
        margin-left: 12%;
    }

    .parameters-container {
        max-height: 320px;
        overflow-y: auto;
        margin-bottom: 15px;
        padding-right: 5px;
    }

    .form-row {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
        margin-top: 5px;
    }

        .form-row input, .form-row select {
            flex: 1;
        }

    .submit-btn {
        display: block;
        margin: 5px auto;
        /* width: 120px; */
    }

    /* Scrollbar خوشگل */
    .parameters-container::-webkit-scrollbar {
        width: 8px;
    }

    .parameters-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
    }

    .parameters-container::-webkit-scrollbar-thumb {
        background: #007bff;
        border-radius: 4px;
    }

        .parameters-container::-webkit-scrollbar-thumb:hover {
            background: #0056b3;
        }

    .remove-btn {
        background: transparent;
        border: none;
        color: red;
        font-size: 18px;
        cursor: pointer;
    }

    .parameters-container {
        scrollbar-width: none;
    }

        .parameters-container::-webkit-scrollbar {
            display: none;
        }

    /* Shadow بالا و پایین فرم اصلی */
    .form-container {
        box-shadow: 0 -10px 15px rgba(0,0,0,.05), 0 10px 20px rgba(0,0,0,.15);
    }

    .invalid {
        border: 2px solid red !important;
    }

</style>


@if (ShowAlert)
{
    <div style="margin-left:11%;z-index:100;max-width: 500px;" class="alert alert-success alert-dismissible fade show" role="alert">
        @AlertMessage
        <button type="button" class="btn-close" @onclick="() => ShowAlert = false"></button>
    </div>
}




<div class="form-container">
    <div class="form-row mb-3 d-block">
        <label class="col-form-label">نام @(ReqOrMess is RequestOrMessageEnum.Message ? "پیام" : "درخواست") :</label>
        <input type="Text" class="form-control" @bind="@ReqOrMessageName"/>
        <label class="col-form-label mt-1">نام تابع اجرا @(ReqOrMess is RequestOrMessageEnum.Message ? "پیام" : "درخواست") :</label>
        <select id="nameSelect" class="form-select" @bind="ReqOrMessageProccessorName" >
            <option value="">انتخاب کنید</option>

            @foreach (var item in ReqOrMessageProccessorNames)
            {
                <option value="@item">@item</option>
            }
        </select>
    </div>
     <div id="parametersContainer" class="parameters-container">
        @for (int i = 0; i < ParameterInputs.Count; i++)
        {
            var currentParameter = ParameterInputs[i];

            <div class="form-row">
                <input type="text" @bind="currentParameter.Name" placeholder="نام پارامتر" class="form-control param-name" />
                <input type="text" @bind="currentParameter.Value" placeholder="مقدار پارامتر" class="form-control param-value" />
                <button type="button" class="btn-sm" style="background-color:red;color:white" @onclick="() => RemoveParameterRow(currentParameter)">✕</button>
                <button type="button" class="btn-sm" style="background-color:lightgreen;color:blue" @onclick="() => AddParameterRow()">+</button>
            </div>

        }
    </div>

    <div class="mt-4">
        <input type="text" @bind="textareaParamName" id="bigName" class="form-control mb-2" placeholder="نام پارامتر">

        <textarea id="bigText" @bind="textareaParamValue" style="overflow-y: scroll;max-height:150px" class="form-control" rows="4" placeholder="مقدار پارامتر"></textarea>
    </div>
     
    <button type="button" disabled="@isLoading" class="btn btn-primary submit-btn" @onclick="() => CreateReqOrMessRedy()">@(reqOrMessId is not null ? "ذخیره ویرایش" : "ایجاد")</button>

    @if (reqOrMessId is not null)
    {
        <button type="button" class="btn btn-outline-secondary submit-btn" @onclick='() => Navigation.NavigateTo($"/ReqOrMessEditDelete/{(int)ReqOrMess}")'>بازگشت به لیست</button>
    }
</div>

@code {

    public class ParameterInput
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
    }
    private bool isLoading = false;

    [Parameter]
    public RequestOrMessageEnum ReqOrMess { get; set; }

    [Parameter]
    public int? reqOrMessId { get; set; }
    public IList<ParameterInput> ParameterInputs { get; set; } = new List<ParameterInput>();
    List<string> ReqOrMessageProccessorNames;


    string ReqOrMessageName;
    string ReqOrMessageProccessorName;
    string textareaParamName;
    string textareaParamValue;

    bool ShowAlert = false;
    string AlertMessage = "";

    protected async override Task OnInitializedAsync()
    {
        ReqOrMessageProccessorNames = operationConfiguration.GetAllMethods().Select(p => p.MethodName).ToList();
        ParameterInputs.Add(new ParameterInput());

    }

    protected override async Task OnParametersSetAsync()
    {
        if (reqOrMessId is not null)
        {
            var result = await requestHubService.ReadAsync(reqOrMessId.Value);
            if (result.IsSuccess && result.Data is not null)
            {
                ReqOrMessageName = result.Data.RequestName;
                ReqOrMessageProccessorName = result.Data.ProcessorName;
                var existingParams = result.Data.Body?.TooDictionary();
                ParameterInputs = (existingParams is not null && existingParams.Count > 0)
                    ? existingParams.Select(kv => new ParameterInput { Name = kv.Key, Value = kv.Value?.ToString() ?? "" }).ToList()
                    : new List<ParameterInput> { new ParameterInput() };
            }
            else
            {
                AlertMessage = "رکورد مورد نظر برای ویرایش یافت نشد.";
                ShowAlert = true;
            }
        }
        await base.OnParametersSetAsync();
    }


   

    private void AddParameterRow()
    {
        ParameterInputs.Add(new ParameterInput());
    }


    private void RemoveParameterRow(ParameterInput parameterToRemove)
    {
        if (ParameterInputs.Count >= 2)
            ParameterInputs.Remove(parameterToRemove);

    }
    public IDictionary<string, object?> GetParameterDictionary()
    {
        var parameterDict = new Dictionary<string, object?>();
        foreach (var paramInput in ParameterInputs)
        {
            if (!string.IsNullOrWhiteSpace(paramInput.Name) && !string.IsNullOrWhiteSpace(paramInput.Value))
            {
                parameterDict.Add(paramInput.Name, paramInput.Value);
            }
        }
        if (!string.IsNullOrEmpty(textareaParamName))
        {
            parameterDict.Add(textareaParamName, textareaParamValue);
        }
        return parameterDict;
    }
    private async Task CreateReqOrMessRedy()
    {
        changeLoading();
        string? data = GetParameterDictionary().ToListString();
        if(string.IsNullOrEmpty(data) && ParameterInputs.Count == 0)
        {
            AlertMessage = "مشکلی در فرایند ایجاد پیش آمد.";
            ShowAlert = true;
            return;
        }
        RabbitConsumerRequestHub packet = new RabbitConsumerRequestHub(data, ReqOrMessageProccessorName, (ReqOrMess is RequestOrMessageEnum.Request), ReqOrMessageName, ReqOrMessageProccessorName);
        if (reqOrMessId is not null)
            packet.Id = reqOrMessId.Value;
        ValidationResult validaitionResult = Validator.Validate(packet);
        if (!validaitionResult.IsValid)
        {
            AlertMessage = validaitionResult.Errors.First().ErrorMessage ?? "";
            ShowAlert = true;
            changeLoading();
            return;
        }
        var result = (reqOrMessId is not null)
            ? await requestHubService.UpdateAsync(packet)
            : await requestHubService.CreateAsync(packet);
        if (!result.IsSuccess)
        {
            AlertMessage = result.ErrMsg??"";
            ShowAlert = true;
            return;
        }
        AlertMessage = (reqOrMessId is not null) ? "ویرایش با موفقیت انجام شد" : "موفق بود";
        ShowAlert = true;

        changeLoading();


    }
    private void changeLoading()
    {
        isLoading = !isLoading;
        StateHasChanged();
    }

}