    private async Task SendRequestAsync()
    {

        if (!ServerSelecteds.Any(s => s.isSelected))
        {
            AlertMessage = "سروری انتخاب نشده است";
            ShowAlert = true;
            return;
        }
        else
            ShowAlert = false;

        if (string.IsNullOrEmpty(ReqOrMessageProccessorName))
        {
            AlertMessage = "نام نمیتواند خالی باشد ";
            ShowAlert = true;
            return;
        }

        if (string.IsNullOrEmpty(ReqOrMessageProccessorName))
        {
            return;
        }
        var requestParameters = ReqOrMessageReadySelected.Body.TooDictionary();

        (IEnumerable<string> ReceiverName, string ProccessorName, IDictionary<string, object?> data, RequestOrMessageEnum requestOrMessageEnum) parm =
        (ServerSelecteds.Where(p => p.isSelected).Select(_ => _.serverInfo.ServerName), ReqOrMessageProccessorName, requestParameters, ReqOrMess);


        // await Task.WhenAll(sendService.SendAuto(parm));

        await foreach (var item in sendService.SendAuto(ServerSelecteds.Where(p => p.isSelected).Select(_ => _.serverInfo.ServerName), ReqOrMessageProccessorName, requestParameters, ReqOrMess))
        {
            // CenterEvent.ServerEventCaller();
        }
    }
    public void ChangeReqName(ChangeEventArgs e)
    {
        ReqOrMessageProccessorName = ReqOrMessageRedyList.First(p => p.Id == Convert.ToInt32(e.Value)).ProcessorName;
        ReqOrMessageReadySelected = ReqOrMessageRedyList.First(p => p.Id == Convert.ToInt32(e.Value));
        StateHasChanged();
    }


    // ServerSelecteds.TakeAllServerOn(ResponseState.Wait, p => p.isSelected);




