@page "/ReqOrMessReadySend/{ReqOrMess:int}"
@using Application.ServiceContract
@using MWSMan.Core.Infrastructure.Extenssion
@using MWSMan.Core.Model.Events
@using MWSMan.Core.Persistence.StaticConfiguration
@using Model.ApplicationModels
@using Model.PresentationModels
@using Persistence
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject IJSRuntime js
@inject IMinooOperationConfiguration operationConfiguration
@inject IList<ServerSelected> ServerSelecteds
@inject CenterEvent CenterEvent
@inject IRequestHubService requestHubService
@inject ISend sendService

<title>ارسال @(ReqOrMess is RequestOrMessageEnum.Message ? "پیام" : "درخواست") آماده</title>
<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

<style>
   /*  body {
        min-height: 100vh;
        display: flex;
