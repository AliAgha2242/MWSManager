@page "/RabbitMonitoring"
@rendermode InteractiveServer
@using MWSManager.Services
@implements IDisposable
@inject IRabbitMqMonitoringService Monitoring

<PageTitle>مانیتورینگ RabbitMQ | MWSManager</PageTitle>

<div class="rabbit-monitor" dir="rtl">
    <header class="rabbit-monitor__header">
        <div>
            <span class="rabbit-monitor__eyebrow">زیرساخت پیام‌رسانی</span>
            <h1>مانیتورینگ RabbitMQ</h1>
            <p>وضعیت صف‌ها، پیام‌های منتظر پردازش و نرخ ورودی و خروجی پیام‌ها</p>
        </div>
        <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@IsLoading">
            @(IsLoading ? "در حال دریافت..." : "بروزرسانی")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>اتصال به RabbitMQ برقرار نشد.</strong>
            <div>@ErrorMessage</div>
            <small>آدرس Management API و دسترسی کاربر را بررسی کنید. پورت پیش‌فرض API مدیریتی ۱۵۶۷۲ است.</small>
        </div>
    }
    else if (Snapshot is null)
    {
        <div class="rabbit-monitor__empty">در حال دریافت اطلاعات RabbitMQ...</div>
    }
    else
    {
        <div class="rabbit-monitor__meta">
            <span>کلاستر: <strong>@(Snapshot.Overview.ClusterName ?? "RabbitMQ")</strong></span>
            <span>نسخه: <strong>@(Snapshot.Overview.RabbitMqVersion ?? "نامشخص")</strong></span>
            <span>آخرین دریافت: <strong>@Snapshot.CollectedAt.ToString("HH:mm:ss")</strong></span>
            <span class="rabbit-monitor__live"><i></i> متصل</span>
        </div>

        <section class="rabbit-monitor__stats">
            <article class="rabbit-stat"><span>کل پیام‌های صف‌شده</span><strong>@N(Snapshot.Overview.QueueTotals?.Messages ?? 0)</strong><small>Ready + Unacknowledged</small></article>
            <article class="rabbit-stat"><span>در انتظار پردازش</span><strong>@N(Snapshot.Overview.QueueTotals?.MessagesReady ?? 0)</strong><small>Messages Ready</small></article>
            <article class="rabbit-stat"><span>در حال پردازش</span><strong>@N(Snapshot.Overview.QueueTotals?.MessagesUnacknowledged ?? 0)</strong><small>Unacknowledged</small></article>
            <article class="rabbit-stat"><span>تعداد صف‌ها</span><strong>@N(Snapshot.Overview.ObjectTotals?.Queues ?? Snapshot.Queues.Count)</strong><small>Queues</small></article>
            <article class="rabbit-stat"><span>مصرف‌کننده‌ها</span><strong>@N(Snapshot.Overview.ObjectTotals?.Consumers ?? Snapshot.Queues.Sum(q => q.Consumers))</strong><small>Consumers</small></article>
            <article class="rabbit-stat"><span>اتصالات</span><strong>@N(Snapshot.Overview.ObjectTotals?.Connections ?? 0)</strong><small>Connections</small></article>
        </section>

        <section class="rabbit-monitor__panel">
            <div class="rabbit-monitor__panel-heading">
                <div><h2>وضعیت صف‌ها</h2><p>صف‌ها بر اساس تعداد پیام، از بیشترین به کمترین مرتب شده‌اند.</p></div>
                <span class="rabbit-monitor__count">@Snapshot.Queues.Count صف</span>
            </div>
            <div class="table-responsive">
                <table class="table rabbit-queues">
                    <thead><tr><th>نام صف</th><th>Virtual host</th><th>وضعیت</th><th>کل پیام</th><th>در انتظار</th><th>در حال پردازش</th><th>مصرف‌کننده</th><th>نرخ ورود / ثانیه</th><th>نرخ خروج / ثانیه</th></tr></thead>
                    <tbody>
                    @foreach (var queue in Snapshot.Queues)
                    {
                        <tr @key="($"{queue.Vhost}/{queue.Name}")">
                            <td class="rabbit-queues__name">@queue.Name</td>
                            <td>@queue.Vhost</td>
                            <td><span class="rabbit-queue-state @(queue.State == "running" ? "is-running" : "is-other")">@queue.State</span></td>
                            <td class="@(queue.Messages > 0 ? "has-messages" : "")">@N(queue.Messages)</td>
                            <td>@N(queue.MessagesReady)</td>
                            <td>@N(queue.MessagesUnacknowledged)</td>
                            <td>@N(queue.Consumers)</td>
                            <td>@queue.MessageStats?.PublishDetails?.Rate.ToString("N2")</td>
                            <td>@queue.MessageStats?.DeliverGetDetails?.Rate.ToString("N2")</td>
                        </tr>
                    }
                    @if (Snapshot.Queues.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center">صفی برای نمایش وجود ندارد.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <p class="rabbit-monitor__note">نکته: نرخ‌ها فقط در صورتی نمایش داده می‌شوند که آمار پیام برای صف در RabbitMQ فعال و موجود باشد.</p>
    }
</div>

<style>
    .rabbit-monitor { max-width: 1700px; margin: 0 auto; padding: 1rem 0 2rem; color: var(--mws-text, #e7edf5); }
    .rabbit-monitor__header, .rabbit-monitor__panel-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
    .rabbit-monitor__header { margin-bottom:1.25rem; }
    .rabbit-monitor__eyebrow { color:#f6c453; font-weight:800; font-size:.85rem; }
    .rabbit-monitor__header h1 { margin:.2rem 0; }
    .rabbit-monitor__header p, .rabbit-monitor__panel-heading p { color:var(--mws-muted,#a5b1c3); margin:0; }
    .rabbit-monitor__meta { display:flex; flex-wrap:wrap; gap:.75rem 1.4rem; align-items:center; padding:1rem 1.2rem; margin-bottom:1rem; border:1px solid var(--mws-border,#354155); border-radius:14px; background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__live { color:#6ee7b7; display:inline-flex; align-items:center; gap:.4rem; }
    .rabbit-monitor__live i { width:8px; height:8px; border-radius:50%; background:#6ee7b7; box-shadow:0 0 0 4px #6ee7b722; }
    .rabbit-monitor__stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-bottom:1.25rem; }
    .rabbit-stat { display:flex; flex-direction:column; gap:.3rem; min-width:0; padding:1.15rem; border:1px solid var(--mws-border,#354155); border-radius:15px; background:linear-gradient(145deg,var(--mws-surface-raised,#202837),var(--mws-surface,#191f2a)); }
    .rabbit-stat span { color:var(--mws-muted,#a5b1c3); font-size:.9rem; }
    .rabbit-stat strong { color:#f6c453; font-size:clamp(1.5rem,2.5vw,2rem); line-height:1.4; overflow-wrap:anywhere; }
    .rabbit-stat small { color:var(--mws-subtle,#7e8ba0)!important; }
    .rabbit-monitor__panel { padding:1.2rem; border:1px solid var(--mws-border,#354155); border-radius:16px; background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__panel-heading { margin-bottom:1rem; }
    .rabbit-monitor__panel-heading h2 { margin:0 0 .2rem; font-size:1.2rem; }
    .rabbit-monitor__count { white-space:nowrap; color:#ffd27a; background:#44351e; padding:.35rem .7rem; border-radius:999px; font-weight:750; }
    .rabbit-queues { min-width:1000px; }
    .rabbit-queues__name { font-weight:750; overflow-wrap:anywhere; }
    .rabbit-queues .has-messages { color:#ffd27a; font-weight:800; }
    .rabbit-queue-state { display:inline-block; padding:.2rem .55rem; border-radius:999px; font-size:.8rem; font-weight:750; }
    .rabbit-queue-state.is-running { color:#9cf0c7; background:#183b32; }
    .rabbit-queue-state.is-other { color:#ffe0a0; background:#44351e; }
    .rabbit-monitor__empty { padding:2rem; border:1px solid var(--mws-border,#354155); border-radius:14px; background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__note { color:var(--mws-muted,#a5b1c3); margin-top:.8rem; font-size:.85rem; }
    @media(max-width:900px) { .rabbit-monitor__stats { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:560px) { .rabbit-monitor__header,.rabbit-monitor__panel-heading { align-items:flex-start; flex-direction:column; } .rabbit-monitor__stats { grid-template-columns:1fr; } }
</style>

@code {
    private RabbitMqMonitoringSnapshot? Snapshot;
    private string? ErrorMessage;
    private bool IsLoading;
    private CancellationTokenSource? _refreshCancellation;
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _refreshCancellation = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = AutoRefreshAsync(_refreshCancellation.Token);
    }

    private async Task AutoRefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RefreshAsync()
    {
        if (IsLoading) return;
        IsLoading = true;
        try
        {
            ErrorMessage = null;
            Snapshot = await Monitoring.GetSnapshotAsync(_refreshCancellation?.Token ?? CancellationToken.None);
        }
        catch (OperationCanceledException) when (_refreshCancellation?.IsCancellationRequested == true) { }
        catch (Exception ex)
        {
            ErrorMessage = ex is HttpRequestException
                ? "به Management API دسترسی نداریم. آدرس، پورت ۱۵۶۷۲، فعال بودن افزونه rabbitmq_management و مجوز کاربر را بررسی کنید."
                : ex.Message;
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string N(long value) => value.ToString("N0");
    private static string N(int value) => value.ToString("N0");

    public void Dispose()
    {
        _refreshCancellation?.Cancel();
        _refreshCancellation?.Dispose();
        _timer?.Dispose();
    }
}
