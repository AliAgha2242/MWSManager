@page "/RabbitMonitoring"
@rendermode InteractiveServer
@using MWSManager.Services
@implements IDisposable
@inject IRabbitMqMonitoringService Monitoring

<PageTitle>مانیتورینگ RabbitMQ | MWSManager</PageTitle>

<div class="rabbit-monitor" dir="rtl">
    <header class="rabbit-monitor__header">
        <div>
            <span class="rabbit-monitor__eyebrow">مرکز پایش زیرساخت</span>
            <h1>مانیتورینگ RabbitMQ</h1>
            <p>وضعیت زنده صف‌ها به‌همراه گزارش هفت روز اخیر ارسال‌ها و رویدادهای ثبت‌شده</p>
        </div>
        <button class="rabbit-monitor__refresh" type="button" @onclick="RefreshAsync" disabled="@IsLoading">
            <span aria-hidden="true">↻</span> @(IsLoading ? "در حال دریافت..." : "بروزرسانی")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(RabbitError))
    {
        <div class="rabbit-monitor__alert" role="alert">
            <strong>دریافت وضعیت زنده RabbitMQ ناموفق بود.</strong>
            <div>@RabbitError</div>
            <small>آدرس Management API، پورت ۱۵۶۷۲ و دسترسی کاربر را بررسی کنید.</small>
        </div>
    }

    @if (Snapshot is not null)
    {
        <div class="rabbit-monitor__meta">
            <span>کلاستر: <strong>@(Snapshot.Overview.ClusterName ?? "RabbitMQ")</strong></span>
            <span>نسخه: <strong>@(Snapshot.Overview.RabbitMqVersion ?? "نامشخص")</strong></span>
            <span>آخرین دریافت: <strong>@Snapshot.CollectedAt.ToString("HH:mm:ss")</strong></span>
            <span class="rabbit-monitor__live"><i></i> اطلاعات زنده</span>
        </div>

        <section class="rabbit-monitor__stats" aria-label="خلاصه وضعیت RabbitMQ">
            <article class="rabbit-stat"><span>کل پیام‌های صف‌شده</span><strong>@N(Snapshot.Overview.QueueTotals?.Messages ?? 0)</strong><small>Ready + Unacknowledged</small></article>
            <article class="rabbit-stat"><span>در انتظار پردازش</span><strong>@N(Snapshot.Overview.QueueTotals?.MessagesReady ?? 0)</strong><small>Messages Ready</small></article>
            <article class="rabbit-stat"><span>در حال پردازش</span><strong>@N(Snapshot.Overview.QueueTotals?.MessagesUnacknowledged ?? 0)</strong><small>Unacknowledged</small></article>
            <article class="rabbit-stat"><span>تعداد صف‌ها</span><strong>@N(Snapshot.Overview.ObjectTotals?.Queues ?? Snapshot.Queues.Count)</strong><small>Queues</small></article>
            <article class="rabbit-stat"><span>مصرف‌کننده‌ها</span><strong>@N(Snapshot.Overview.ObjectTotals?.Consumers ?? Snapshot.Queues.Sum(q => q.Consumers))</strong><small>Consumers</small></article>
            <article class="rabbit-stat"><span>اتصالات</span><strong>@N(Snapshot.Overview.ObjectTotals?.Connections ?? 0)</strong><small>Connections</small></article>
        </section>

        <section class="rabbit-monitor__panel">
            <div class="rabbit-monitor__panel-heading">
                <div><h2>وضعیت صف‌ها بر اساس Virtual Host</h2><p>برای دیدن صف‌های هر vhost، گروه مربوط را باز کنید.</p></div>
                <span class="rabbit-monitor__count">@Snapshot.Queues.Count صف در @Snapshot.Queues.Select(q => q.Vhost).Distinct(StringComparer.OrdinalIgnoreCase).Count() ‏VHost</span>
            </div>
            @if (Snapshot.Queues.Count == 0)
            {
                <div class="rabbit-monitor__empty">صفی برای نمایش وجود ندارد.</div>
            }
            else
            {
                <div class="rabbit-monitor__vhosts">
                    @foreach (var group in Snapshot.Queues.GroupBy(q => q.Vhost ?? "/", StringComparer.OrdinalIgnoreCase).OrderBy(g => g.Key))
                    {
                        <details class="rabbit-monitor__collapse rabbit-monitor__vhost" @key="group.Key">
                            <summary>
                                <span class="rabbit-monitor__collapse-title"><span class="rabbit-monitor__chevron">⌄</span><strong>@group.Key</strong></span>
                                <span class="rabbit-monitor__collapse-meta">@group.Count() صف <span>·</span> @N(group.Sum(q => q.Messages)) پیام <span>·</span> @N(group.Sum(q => q.Consumers)) مصرف‌کننده</span>
                            </summary>
                            <div class="table-responsive rabbit-monitor__collapse-body">
                                <table class="table rabbit-queues">
                                    <thead><tr><th>نام صف / سرور</th><th>وضعیت</th><th>کل پیام</th><th>در انتظار</th><th>در حال پردازش</th><th>مصرف‌کننده</th><th>نرخ ورود / ثانیه</th><th>نرخ خروج / ثانیه</th></tr></thead>
                                    <tbody>
                                    @foreach (var queue in group.OrderByDescending(q => q.Messages))
                                    {
                                        <tr @key="queue.Name">
                                            <td class="rabbit-queues__name">@queue.Name</td>
                                            <td><span class="rabbit-queue-state @(queue.State == "running" ? "is-running" : "is-other")">@queue.State</span></td>
                                            <td class="@(queue.Messages > 0 ? "has-messages" : "")">@N(queue.Messages)</td>
                                            <td>@N(queue.MessagesReady)</td>
                                            <td>@N(queue.MessagesUnacknowledged)</td>
                                            <td>@N(queue.Consumers)</td>
                                            <td>@(queue.MessageStats?.PublishDetails is { } publish ? publish.Rate.ToString("N2") : "—")</td>
                                            <td>@(queue.MessageStats?.DeliverGetDetails is { } deliver ? deliver.Rate.ToString("N2") : "—")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            }
        </section>
    }
    else if (string.IsNullOrWhiteSpace(RabbitError))
    {
        <div class="rabbit-monitor__empty">در حال دریافت وضعیت زنده RabbitMQ...</div>
    }

    <section class="rabbit-monitor__panel rabbit-monitor__sql">
        <div class="rabbit-monitor__panel-heading">
            <div><h2>گزارش ارتباط سرورها</h2><p>گزارش هفت روز اخیر؛ فیلتر بر اساس فرستنده و گیرنده</p></div>
            <span class="rabbit-monitor__count">@FilteredLogSummaries.Count از @LogSummaries.Count ردیف</span>
        </div>
        <div class="rabbit-monitor__filters">
            <label>
                <span>فرستنده</span>
                <select class="rabbit-monitor__select" @bind="SelectedSender">
                    <option value="">همه فرستنده‌ها</option>
                    @foreach (var sender in LogSummaries.Select(x => x.SenderName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x))
                    {
                        <option value="@sender">@sender</option>
                    }
                </select>
            </label>
            <label>
                <span>گیرنده</span>
                <select class="rabbit-monitor__select" @bind="SelectedReceiver">
                    <option value="">همه گیرنده‌ها</option>
                    @foreach (var receiver in LogSummaries.Select(x => x.ReceiverName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x))
                    {
                        <option value="@receiver">@receiver</option>
                    }
                </select>
            </label>
            <button type="button" class="rabbit-monitor__clear-filter" @onclick="ClearLogFilters">پاک‌کردن فیلترها</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(SqlError))
        {
            <div class="rabbit-monitor__alert" role="alert">
                <strong>گزارش دیتابیس در دسترس نیست.</strong>
                <div>@SqlError</div>
                <small>تنظیم ConnectionStrings را برای دیتابیسی که جدول‌های RabbitConsumerLog در آن قرار دارند بررسی کنید.</small>
            </div>
        }
        else if (FilteredLogSummaries.Count == 0)
        {
            <div class="rabbit-monitor__empty">با فیلترهای انتخاب‌شده گزارشی پیدا نشد.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table rabbit-queues">
                    <thead><tr><th>تاریخ</th><th>فرستنده (SenderName)</th><th>گیرنده (ReceiverName)</th><th>تعداد لاگ</th><th>خطاها</th><th>دارای ErrorMessageId</th></tr></thead>
                    <tbody>
                    @foreach (var row in FilteredLogSummaries)
                    {
                        <tr @key="(row.LogDate, row.SenderName, row.ReceiverName)">
                            <td>@row.LogDate.ToString("yyyy-MM-dd")</td>
                            <td class="rabbit-queues__name">@(string.IsNullOrWhiteSpace(row.SenderName) ? "—" : row.SenderName)</td>
                            <td class="rabbit-queues__name">@(string.IsNullOrWhiteSpace(row.ReceiverName) ? "—" : row.ReceiverName)</td>
                            <td>@N(row.TotalLogs)</td>
                            <td class="@(row.ErrorCount > 0 ? "has-errors" : "")">@N(row.ErrorCount)</td>
                            <td class="@(row.ErrorMessageCount > 0 ? "has-errors" : "")">@N(row.ErrorMessageCount)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <details class="rabbit-monitor__panel rabbit-monitor__sql rabbit-monitor__collapse rabbit-monitor__events">
        <summary class="rabbit-monitor__panel-heading">
            <span class="rabbit-monitor__collapse-title"><span class="rabbit-monitor__chevron">⌄</span><span><strong>رویدادهای ثبت‌شده</strong><small>خلاصه RabbitConsumerLogDetail به‌همراه شرح رویداد از RabbitMessage</small></span></span>
            <span class="rabbit-monitor__count">@LogEvents.Count رویداد</span>
        </summary>
        <div class="rabbit-monitor__collapse-body">
            @if (!string.IsNullOrWhiteSpace(SqlError))
            {
                <div class="rabbit-monitor__empty">به دلیل خطای اتصال دیتابیس، رویدادها قابل نمایش نیستند.</div>
            }
            else if (LogEvents.Count == 0)
            {
                <div class="rabbit-monitor__empty">در بازه هفت روز اخیر رویدادی پیدا نشد.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rabbit-queues">
                        <thead><tr><th>تاریخ</th><th>شناسه</th><th>شرح رویداد</th><th>عملیات</th><th>سطح</th><th>تعداد</th><th>توقف برنامه</th><th>پایان کامل</th></tr></thead>
                        <tbody>
                        @foreach (var row in LogEvents)
                        {
                            <tr @key="(row.LogDate, row.MessageId, row.CurrentOperation, row.LogLevel)">
                                <td>@row.LogDate.ToString("yyyy-MM-dd")</td>
                                <td>@row.MessageId</td>
                                <td class="rabbit-queues__description">@row.MessageDescription</td>
                                <td>@(string.IsNullOrWhiteSpace(row.CurrentOperation) ? "—" : row.CurrentOperation)</td>
                                <td><span class="rabbit-queue-state @(IsError(row.LogLevel) || row.StopProgramCount > 0 ? "is-other" : "is-running")">@row.LogLevel</span></td>
                                <td>@N(row.EventCount)</td>
                                <td class="@(row.StopProgramCount > 0 ? "has-errors" : "")">@N(row.StopProgramCount)</td>
                                <td>@N(row.TotalFinishCount)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>
    <p class="rabbit-monitor__note">بروزرسانی خودکار هر ۱۵ ثانیه انجام می‌شود. نرخ پیام‌ها از Management API می‌آید؛ گزارش‌ها از دیتابیس خوانده می‌شوند. زمان پردازش در گزارش اصلی محاسبه نشده، چون ProccessDate در داده‌های فعلی خالی است.</p>
</div>

<style>
    .rabbit-monitor { max-width: 1800px; margin: 0 auto; padding: 1rem 0 2rem; color: var(--mws-text, #e7edf5); }
    .rabbit-monitor__header, .rabbit-monitor__panel-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
    .rabbit-monitor__header { margin-bottom:1.25rem; }
    .rabbit-monitor__eyebrow { color:#f6c453; font-weight:800; font-size:.85rem; }
    .rabbit-monitor__header h1 { margin:.2rem 0; }
    .rabbit-monitor__header p, .rabbit-monitor__panel-heading p { color:var(--mws-muted,#a5b1c3); margin:0; }
    .rabbit-monitor__refresh { display:inline-flex; align-items:center; gap:.5rem; padding:.7rem 1rem; border:1px solid #b98527; border-radius:11px; color:#201a0e; background:linear-gradient(135deg,#ffd779,#f59e0b); font:inherit; font-weight:800; cursor:pointer; white-space:nowrap; }
    .rabbit-monitor__refresh:disabled { opacity:.65; cursor:wait; }
    .rabbit-monitor__refresh span { font-size:1.3rem; line-height:1; }
    .rabbit-monitor__meta { display:flex; flex-wrap:wrap; gap:.75rem 1.4rem; align-items:center; padding:1rem 1.2rem; margin-bottom:1rem; border:1px solid var(--mws-border,#354155); border-radius:14px; background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__live { color:#6ee7b7; display:inline-flex; align-items:center; gap:.4rem; }
    .rabbit-monitor__live i { width:8px; height:8px; border-radius:50%; background:#6ee7b7; box-shadow:0 0 0 4px #6ee7b722; }
    .rabbit-monitor__stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; margin-bottom:1.25rem; }
    .rabbit-stat { display:flex; flex-direction:column; gap:.3rem; min-width:0; padding:1.15rem; border:1px solid var(--mws-border,#354155); border-radius:15px; background:linear-gradient(145deg,var(--mws-surface-raised,#202837),var(--mws-surface,#191f2a)); }
    .rabbit-stat span { color:var(--mws-muted,#a5b1c3); font-size:.9rem; }
    .rabbit-stat strong { color:#f6c453; font-size:clamp(1.5rem,2.5vw,2rem); line-height:1.4; overflow-wrap:anywhere; }
    .rabbit-stat small { color:var(--mws-subtle,#7e8ba0)!important; }
    .rabbit-monitor__panel { margin-bottom:1.15rem; padding:1.2rem; border:1px solid var(--mws-border,#354155); border-radius:16px; background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__panel-heading { margin-bottom:1rem; }
    .rabbit-monitor__panel-heading h2 { margin:0 0 .2rem; font-size:1.2rem; }
    .rabbit-monitor__count { white-space:nowrap; color:#ffd27a; background:#44351e; padding:.35rem .7rem; border-radius:999px; font-weight:750; }
    .rabbit-queues { min-width:1000px; margin-bottom:0; }
    .rabbit-queues__name { font-weight:750; overflow-wrap:anywhere; }
    .rabbit-queues__description { min-width:250px; max-width:460px; white-space:normal; }
    .rabbit-queues .has-messages { color:#ffd27a; font-weight:800; }
    .rabbit-queues .has-errors { color:#ff9b8b; font-weight:850; }
    .rabbit-queue-state { display:inline-block; padding:.2rem .55rem; border-radius:999px; font-size:.8rem; font-weight:750; }
    .rabbit-queue-state.is-running { color:#9cf0c7; background:#183b32; }
    .rabbit-queue-state.is-other { color:#ffe0a0; background:#44351e; }
    .rabbit-monitor__alert { margin:.6rem 0; padding:1rem; border:1px solid #814b38; border-radius:12px; color:#ffd8ca; background:#3a2422; overflow-wrap:anywhere; }
    .rabbit-monitor__alert small { display:block; margin-top:.4rem; color:#e6b5a5; }
    .rabbit-monitor__empty { padding:1.25rem; border:1px dashed var(--mws-border,#354155); border-radius:12px; color:var(--mws-muted,#a5b1c3); background:var(--mws-surface,#191f2a); }
    .rabbit-monitor__note { color:var(--mws-muted,#a5b1c3); margin-top:.8rem; font-size:.85rem; }
    .rabbit-monitor__vhosts { display:flex; flex-direction:column; gap:.7rem; }
    .rabbit-monitor__collapse { min-width:0; }
    .rabbit-monitor__vhost { border:1px solid var(--mws-border,#354155); border-radius:12px; background:var(--mws-surface-raised,#202837); overflow:hidden; }
    .rabbit-monitor__collapse > summary { display:flex; align-items:center; justify-content:space-between; gap:1rem; cursor:pointer; list-style:none; padding:.9rem 1rem; }
    .rabbit-monitor__collapse > summary::-webkit-details-marker { display:none; }
    .rabbit-monitor__collapse > summary::marker { content:""; }
    .rabbit-monitor__collapse[open] > summary { border-bottom:1px solid var(--mws-border,#354155); }
    .rabbit-monitor__collapse-title { display:inline-flex; align-items:center; gap:.7rem; min-width:0; }
    .rabbit-monitor__collapse-title strong { color:var(--mws-text,#e7edf5); font-size:1rem; }
    .rabbit-monitor__chevron { display:inline-flex; align-items:center; justify-content:center; width:1.7rem; height:1.7rem; border-radius:8px; color:#ffd27a; background:#44351e; transition:transform .18s ease; }
    .rabbit-monitor__collapse[open] > summary .rabbit-monitor__chevron { transform:rotate(180deg); }
    .rabbit-monitor__collapse-meta { display:inline-flex; flex-wrap:wrap; gap:.4rem; align-items:center; color:var(--mws-muted,#a5b1c3); font-size:.85rem; }
    .rabbit-monitor__collapse-body { padding:.8rem 1rem 1rem; }
    .rabbit-monitor__events > summary { margin:0; }
    .rabbit-monitor__events .rabbit-monitor__collapse-title { text-align:right; }
    .rabbit-monitor__events .rabbit-monitor__collapse-title span:last-child { display:flex; flex-direction:column; gap:.2rem; }
    .rabbit-monitor__events .rabbit-monitor__collapse-title small { color:var(--mws-muted,#a5b1c3); font-weight:400; }
    .rabbit-monitor__filters { display:flex; flex-wrap:wrap; align-items:end; gap:.8rem; margin:0 0 1rem; padding:1rem; border:1px solid var(--mws-border,#354155); border-radius:12px; background:var(--mws-surface-raised,#202837); }
    .rabbit-monitor__filters label { display:flex; flex-direction:column; gap:.35rem; min-width:190px; flex:1; color:var(--mws-muted,#a5b1c3); font-size:.85rem; font-weight:700; }
    .rabbit-monitor__select { width:100%; min-height:42px; padding:.55rem .7rem; border:1px solid var(--mws-border,#354155); border-radius:9px; color:var(--mws-text,#e7edf5); background:var(--mws-surface,#191f2a); font:inherit; }
    .rabbit-monitor__clear-filter { min-height:42px; padding:.55rem .9rem; border:1px solid #b98527; border-radius:9px; color:#ffd27a; background:transparent; font:inherit; font-weight:750; cursor:pointer; }
    .rabbit-monitor__clear-filter:hover { background:#44351e; }
    
    
</style>

@code {
    private RabbitMqMonitoringSnapshot? Snapshot;
    private IReadOnlyList<RabbitMqLogSummary> LogSummaries = Array.Empty<RabbitMqLogSummary>();
    private IReadOnlyList<RabbitMqLogEventSummary> LogEvents = Array.Empty<RabbitMqLogEventSummary>();
    private string SelectedSender = "";
    private string SelectedReceiver = "";

    private IReadOnlyList<RabbitMqLogSummary> FilteredLogSummaries => LogSummaries
        .Where(row => string.IsNullOrWhiteSpace(SelectedSender) ||
                      string.Equals(row.SenderName, SelectedSender, StringComparison.OrdinalIgnoreCase))
        .Where(row => string.IsNullOrWhiteSpace(SelectedReceiver) ||
                      string.Equals(row.ReceiverName, SelectedReceiver, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    private void ClearLogFilters()
    {
        SelectedSender = "";
        SelectedReceiver = "";
    }
    private string? RabbitError;
    private string? SqlError;
    private bool IsLoading;
    private CancellationTokenSource? _refreshCancellation;
    private PeriodicTimer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _refreshCancellation = new CancellationTokenSource();
        await RefreshAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _ = AutoRefreshAsync(_refreshCancellation.Token);
    }

    private async Task AutoRefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RefreshAsync()
    {
        if (IsLoading) return;
        IsLoading = true;
        try
        {
            var token = _refreshCancellation?.Token ?? CancellationToken.None;
            RabbitError = null;
            SqlError = null;

            try
            {
                Snapshot = await Monitoring.GetSnapshotAsync(token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
            catch (Exception ex)
            {
                RabbitError = ex is HttpRequestException
                    ? "به Management API دسترسی نداریم. آدرس، پورت ۱۵۶۷۲، فعال بودن افزونه rabbitmq_management و مجوز کاربر را بررسی کنید."
                    : ex.Message;
            }

            try
            {
                var summariesTask = Monitoring.GetLogSummaryAsync(token);
                var eventsTask = Monitoring.GetLogEventsAsync(token);
                await Task.WhenAll(summariesTask, eventsTask);
                LogSummaries = await summariesTask;
                LogEvents = await eventsTask;
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
            catch (Exception ex)
            {
                SqlError = ex is Microsoft.Data.SqlClient.SqlException
                    ? "اتصال یا اجرای پرس‌وجو روی دیتابیس ناموفق بود. اتصال دیتابیس و وجود جدول‌های گزارش را بررسی کنید."
                    : ex.Message;
                LogSummaries = Array.Empty<RabbitMqLogSummary>();
                LogEvents = Array.Empty<RabbitMqLogEventSummary>();
            }
        }
        catch (OperationCanceledException) when (_refreshCancellation?.IsCancellationRequested == true) { }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string N(long value) => value.ToString("N0");
    private static string N(int value) => value.ToString("N0");
    private static bool IsError(string? level) => string.Equals(level, "Error", StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        _refreshCancellation?.Cancel();
        _refreshCancellation?.Dispose();
        _timer?.Dispose();
    }
}
